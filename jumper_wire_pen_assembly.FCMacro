# -*- coding: utf-8 -*-
"""
Jumper Wire Pen - FULL PEN  (live, parametric)                 FreeCAD macro
=========================================================================
Run it from  Macro > Macros...  One window opens and STAYS OPEN: change any size
and the pen in the 3D view is rebuilt a moment later.  Close the window when you
are done.  Your last values are remembered.

The pen, rear to front:

    SPOOL HOLDER < body segments < pen tip

  - Body segments: identical, a threaded stub at one end and a threaded socket at the
    other.  Choose how many go between the spool holder and the tip.
  - Spool holder: a round drum at the rear end of the pen with one socket at the front
    (the first body segment, or the tip, screws into its round nose), exactly in line with the pen
    (looking down the spool axis, the pen runs through its centre).  The bought spool lies
    on its side inside, centred on the pen axis; the wire leaves the rim of the spool into
    a funnel and runs along the pen to the needle.  The big round knob on top is the lid:
    it has a thick grip rim, is hollow to save plastic, and screws on and off by hand, no tools.
  - Pen tip: holds the bought needle tube.
Thread, body diameter and wire hole are shared, so all parts always fit.

The thread is made for FDM printing: coarse step, 45-degree flanks (no flat
overhangs), flat crests and roots at least as wide as one nozzle line.

Printing: tip and segments stand on their thread stub, the holder lies flat (spool axis
pointing up), the lid lies on its knob with the thread pointing up.  Use "Show one part in
print orientation" in the View tab.  The Colors tab sets the
display color of every part.
"""
import math
import os
import FreeCAD as App
import FreeCADGui as Gui
import Part
from FreeCAD import Vector as V

try:
    from PySide import QtWidgets, QtCore
except ImportError:
    from PySide import QtGui as QtWidgets, QtCore
from PySide import QtGui

DOC_NAME = "JumperWirePen_Assembly"
PREF_PATH = "User parameter:BaseApp/Preferences/Macro/JumperWirePenAssemblyV2"
OLD_PREF_PATHS = (("User parameter:BaseApp/Preferences/Macro/JumperWirePenTipV2", None),
                  ("User parameter:BaseApp/Preferences/Macro/JumperWirePenBodyV1", ("seg_len", "fit_clr")),
                  ("User parameter:BaseApp/Preferences/Macro/JumperWirePenAssemblyV1", None))
DIALOG_NAME = "JumperWirePenAssemblyDialog"

SOCKET_EXTRA = 0.5      # a socket is this much deeper than its stub is long
SPREAD_GAP = 12.0       # gap between parts in the "spread apart" view
MAX_SEG = 6
PART_NAMES = ["Pen tip", "Body segment", "Spool holder", "Spool holder lid"]

# key, label, default, min, max, step, group                    (sizes in mm)
PARAMS = [
    ("base_len",     "Straight part before the taper",               3.0,  0.5,  20.0, 0.5,  "Tip shape"),
    ("taper_len",    "Taper length",                                22.0,  5.0, 100.0, 1.0,  "Tip shape"),
    ("tip_d",        "Tip end diameter",                             4.5,  3.0,  15.0, 0.1,  "Tip shape"),
    ("collar_len",   "Tip end collar length",                        3.0,  1.0,  15.0, 0.5,  "Tip shape"),
    ("body_d",       "Body diameter (tip, segments, holder nose)",           9.0,  6.0,  30.0, 0.5,  "Body"),
    ("seg_len",      "Segment length (shoulder to front face)",     20.0,  6.0,  60.0, 1.0,  "Body"),
    ("thread_d",     "Thread outer diameter",                        6.0,  3.0,  28.0, 0.5,  "Thread"),
    ("thread_pitch", "Thread step (distance per turn)",              2.5,  1.0,   6.0, 0.1,  "Thread"),
    ("thread_depth", "Thread depth",                                0.75,  0.3,   2.5, 0.05, "Thread"),
    ("thread_len",   "Thread length (stub length)",                  8.0,  4.0,  24.0, 0.5,  "Thread"),
    ("fit_clr",      "Fit clearance (socket bigger, each side)",     0.2,  0.0,   0.6, 0.05, "Thread"),
    ("chan_d",       "Wire hole diameter (through the whole pen)",   1.0,  0.3,   6.0, 0.1,  "Holes and needle"),
    ("tube_od",      "Needle tube outer diameter",                   1.6,  0.6,   6.0, 0.05, "Holes and needle"),
    ("seat_clr",     "Needle seat clearance (each side)",           0.05,  0.0,   0.5, 0.01, "Holes and needle"),
    ("tube_id",      "Needle tube inner diameter (preview only)",    0.6,  0.2,   5.0, 0.05, "Holes and needle"),
    ("tube_insert",  "Tube depth inside the tip (0 = no seat, the tube sits on the end face)", 10.0,  0.0,  40.0, 1.0,  "Holes and needle"),
    ("tube_out",     "Tube length sticking out",                    25.0,  5.0,  60.0, 1.0,  "Holes and needle"),
    ("spool_d",      "Spool outer diameter (widest part)",          18.0,  8.0,  60.0, 0.5,  "Spool holder"),
    ("spool_wid",    "Spool total width (the spool you use now)",    6.4,  2.0,  30.0, 0.1,  "Spool holder"),
